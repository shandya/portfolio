# Backend API base URL (includes /api path). Used by server code and the client archive page.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional server-only override (preferred for server components / actions)
# API_URL=http://localhost:3001/api
# Password to sign into /cms
CMS_PASSWORD=change-me
# Secret used to sign CMS session cookies (generate: openssl rand -hex 32)
CMS_SESSION_SECRET=change-me-too
# Must match ADMIN_API_KEY in portfolio-be
BACKEND_ADMIN_KEY=change-me
